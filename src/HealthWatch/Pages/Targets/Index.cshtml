@page
@functions {
    public class TargetsIndexModel(AppDbContext db) : PageModel
    {
        public List<Target> Targets { get; set; } = [];
        public async Task OnGetAsync() => Targets = await db.Targets.OrderBy(t => t.Name).ToListAsync();

        public async Task<IActionResult> OnPostDeleteAsync(int id)
        {
            await db.Results.Where(r => r.TargetId == id).ExecuteDeleteAsync();
            await db.Incidents.Where(i => i.TargetId == id).ExecuteDeleteAsync();
            await db.Targets.Where(t => t.Id == id).ExecuteDeleteAsync();
            return RedirectToPage();
        }
    }
}
@model TargetsIndexModel
@{ ViewData["Title"] = "Targets"; }
<div class="d-flex justify-content-end mb-3"><a class="btn btn-primary" asp-page="Edit">+ Add target</a></div>
<div class="table-wrap"><table class="table align-middle">
    <thead><tr><th>Name</th><th>Type</th><th>Target</th><th>Every</th><th>Enabled</th><th></th></tr></thead>
    <tbody>
    @foreach (var t in Model.Targets)
    {
        <tr>
            <td class="fw-semibold">@t.Name</td>
            <td>@t.Kind</td>
            <td>@(t.Kind == TargetKind.Http ? t.Url : t.Provider.ToString())</td>
            <td>@t.IntervalSeconds s</td>
            <td><span class="badge @(t.Enabled ? "bg-success" : "bg-secondary")">@(t.Enabled ? "Enabled" : "Disabled")</span></td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@t.Id">Edit</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" class="d-inline" onsubmit="return confirm('Delete @t.Name and its history?')">
                    <button class="btn btn-sm btn-outline-danger">Delete</button></form>
            </td>
        </tr>
    }
    </tbody>
</table></div>
